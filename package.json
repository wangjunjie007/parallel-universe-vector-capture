  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "@testing-library/jest-dom": "6.6.3",
    "typescript": "5.7.2",
    "vite": "5.4.21",
    "@types/node": "22.10.2",
    "vitest": "2.1.8"
  }
}
