{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parallel-universe-vector-capture.example/schemas/semantic_tracks.schema.json",
  "title": "Strict 0/4/10 semantic tracks",
  "type": "object",
  "additionalProperties": false,
  "required": ["frame_count", "width", "height", "transitions", "frames"],
  "properties": {
    "frame_count": { "type": "integer", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 },
    "transitions": { "type": "object" },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } }
  },
  "$defs": {
    "frame": {
      "type": "object", "additionalProperties": false, "required": ["frame", "time", "count", "points"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0 }, "time": { "type": "number", "minimum": 0 },
        "count": { "enum": [0, 4, 10] },
        "points": {
          "type": "array", "minItems": 0, "maxItems": 10,
          "items": { "$ref": "#/$defs/point" }
        }
      },
      "allOf": [
        { "if": { "properties": { "count": { "const": 0 } } }, "then": { "properties": { "points": { "maxItems": 0 } } } },
        { "if": { "properties": { "count": { "const": 4 } } }, "then": { "properties": { "points": { "minItems": 4, "maxItems": 4 } } } },
        { "if": { "properties": { "count": { "const": 10 } } }, "then": { "properties": { "points": { "minItems": 10, "maxItems": 10 } } } }
      ]
    },
    "point": {
      "type": "object", "additionalProperties": false, "required": ["side", "finger", "x", "y"],
      "properties": {
        "side": { "enum": ["hand_1", "hand_2"] },
        "finger": { "enum": ["thumb", "index", "middle", "ring", "little"] },
        "x": { "type": "number" }, "y": { "type": "number" }
      }
    }
  }
}
